# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=heartline

# Application Settings
APP_NAME=Heartline Desktop
APP_VERSION=1.0.0
DEBUG=false

# Security
SECRET_KEY=your-secret-key-here

# AI Model Settings
ONNX_MODEL_PATH=models/resnet34_ecg.onnx

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/heartline.log

# UI Settings
THEME=dark_blue.xml

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=mat,hea,pdf,jpg,jpeg,png
