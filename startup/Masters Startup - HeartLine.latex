\textbf{2. Qardiax \protect\hyperlink{references}{{[}45{]}}}

\begin{itemize}
\item
  \emph{Strengths}: Hospital-grade AI diagnostics.
\item
  \emph{Limitations}: Centralized black-box model, weak edge
  capabilities, privacy compliance gaps.
\item
  \emph{HeartLine Edge}: Transparent FL, local training, open
  explainability, designed for Algerian sovereignty norms.
\end{itemize}

\textbf{3. Philips / GE AI-ECG Suites
\protect\hyperlink{references}{{[}46{]}}}

