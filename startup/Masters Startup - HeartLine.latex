  >{\raggedright\arraybackslash}p{(\columnwidth - 4\tabcolsep) * \real{0.2756}}
  >{\raggedright\arraybackslash}p{(\columnwidth - 4\tabcolsep) * \real{0.3572}}
  >{\raggedright\arraybackslash}p{(\columnwidth - 4\tabcolsep) * \real{0.3671}}@{}}
